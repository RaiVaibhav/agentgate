{
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:all": "pnpm build && pnpm --filter @agent-permission/proxy build && pnpm --filter @agent-permission/mcp-gateway build && pnpm --filter @agentgate/contract build && pnpm --filter @agentgate/compiler build && pnpm --filter @agentgate/runtime build",
    "contract:build": "pnpm --filter @agentgate/contract build",
    "compiler:build": "pnpm --filter @agentgate/compiler build",
    "runtime:build": "pnpm --filter @agentgate/runtime build",
    "test:compiler": "tsx agentgate-mvp/src/eval/score-compiler.ts",
    "test:runtime": "tsx agentgate-mvp/src/eval/score-runtime.ts",
    "test:all": "pnpm run test:compiler && pnpm run test:runtime",
    "benchmark:compiler": "tsx benchmarks/score-compiler.ts",
    "benchmark:runtime": "tsx benchmarks/score-runtime.ts",
    "benchmark:all": "tsx benchmarks/score-compiler.ts && tsx benchmarks/score-runtime.ts",
    "agentgate": "tsx packages/compiler/src/cli.ts",
    "start": "next start",
    "db:setup": "tsx lib/db/setup.ts",
    "db:seed": "tsx lib/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:all": "drizzle-kit migrate && pnpm --filter @agent-permission/proxy db:migrate",
    "db:studio": "drizzle-kit studio",
    "proxy:dev": "pnpm --filter @agent-permission/proxy dev",
    "proxy:migrate": "pnpm --filter @agent-permission/proxy db:migrate",
    "proxy:generate": "pnpm --filter @agent-permission/proxy db:generate",
    "proxy:seed": "pnpm --filter @agent-permission/proxy db:seed",
    "dummy:dev": "pnpm --filter @agent-permission/dummy-app dev",
    "dummy:migrate": "pnpm --filter @agent-permission/dummy-app db:migrate",
    "dummy:generate": "pnpm --filter @agent-permission/dummy-app db:generate",
    "backend:dev": "concurrently \"pnpm proxy:dev\" \"pnpm dummy:dev\"",
    "mcp:build": "pnpm --filter @agent-permission/mcp-server build",
    "mcp:dev": "pnpm --filter @agent-permission/mcp-server dev",
    "proxy-wrap:build": "pnpm --filter @agent-permission/mcp-proxy build",
    "proxy-wrap:dev": "pnpm --filter @agent-permission/mcp-proxy dev",
    "gateway:dev": "pnpm --filter @agent-permission/mcp-gateway dev",
    "gateway:build": "pnpm --filter @agent-permission/mcp-gateway build",
    "test:e2e": "bash backend/test-e2e.sh"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.1.7",
    "@types/node": "^22.15.18",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.43.1",
    "jose": "^6.0.11",
    "lucide-react": "^0.511.0",
    "next": "15.6.0-canary.59",
    "postcss": "^8.5.29",
    "postgres": "^3.4.9",
    "radix-ui": "^1.4.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "stripe": "^18.1.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.1.7",
    "ts-morph": "^28.0.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.8.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "concurrently": "^9.1.2",
    "openai": "^7.41.0",
    "tsx": "^4.22.4"
  }
}
